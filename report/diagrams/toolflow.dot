digraph flow {
  rankdir=LR; fontname="Helvetica"; nodesep=0.35; ranksep=0.45;
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#EAF2FB", margin="0.12,0.06"]; edge [fontname="Helvetica", fontsize=8];
  rtl [label="Verilog RTL\n(rtl/*.v)", fillcolor="#D9EAD3"];
  tb  [label="Self-checking testbench\n+ reference memory\n+ memory model (sim/)", fillcolor="#FCE5CD"];
  sim [label="Icarus Verilog\niverilog + vvp"];
  vcd [label="VCD waveform\n(wave.vcd)"];
  log [label="Simulation log\nPASS / FAIL"];
  perf[label="tb_perf + Python\nanalyze_results.py"];
  csv [label="CSV tables\n+ plots"];
  gtk [label="GTKWave", fillcolor="#F4CCCC"];
  portal [label="Web portal\n(browser viewer)", fillcolor="#F4CCCC"];
  yos [label="Yosys\nsynthesis"];
  rep [label="Resource\nreports"];
  rtl -> sim; tb -> sim; sim -> vcd; sim -> log; vcd -> gtk; vcd -> portal [label="indexed by\nbackend"];
  rtl -> perf; perf -> csv; rtl -> yos; yos -> rep;
}
