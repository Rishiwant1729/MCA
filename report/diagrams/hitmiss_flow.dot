digraph hm {
  rankdir=TB; fontname="Helvetica"; nodesep=0.3; ranksep=0.32;
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#EAF2FB", margin="0.12,0.06"]; edge [fontname="Helvetica", fontsize=9];
  req [label="CPU request: address", fillcolor="#D9EAD3"];
  chk [label="Aligned, in range,\nread request?", shape=diamond, fillcolor="#FFF2CC"];
  err [label="Respond with resp_err=1\n(1 cycle)", fillcolor="#F4CCCC"];
  dec [label="Split address:\ntag | index | offset"];
  rd  [label="Read valid bit, tag and data\nat line [index]"];
  cmp [label="valid = 1 AND\nstored tag = request tag?", shape=diamond, fillcolor="#FFF2CC"];
  hit [label="HIT: select word\n[offset] from line", fillcolor="#D9EAD3"];
  miss[label="MISS: request block\nat {tag,index,0000}\nfrom main memory", fillcolor="#FCE5CD"];
  wait[label="Wait for block\n(LAT cycles)"];
  fill[label="Refill: write data, tag,\nset valid = 1"];
  resp[label="Return word [offset]\nresp_valid pulse", fillcolor="#D9EAD3"];
  req -> chk; chk -> err [label="no"]; chk -> dec [label="yes"]; dec -> rd -> cmp;
  cmp -> hit [label="yes"]; cmp -> miss [label="no"]; miss -> wait -> fill -> resp; hit -> resp;
}
