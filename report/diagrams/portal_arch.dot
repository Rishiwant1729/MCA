digraph portal {
  rankdir=LR; fontname="Helvetica"; nodesep=0.3; ranksep=0.5;
  node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="#EAF2FB", margin="0.12,0.06"]; edge [fontname="Helvetica", fontsize=8];
  subgraph cluster_b { label="Browser (static page, no server code)"; fontname="Helvetica"; style=rounded;
    ui  [label="Scenario + latency\nselector"];
    wv  [label="Canvas waveform viewer\nzoom / pan / cursor"];
    fsm [label="FSM view"]; cl [label="Cache-line table"];
  }
  subgraph cluster_s { label="Local backend (127.0.0.1:8765, Python stdlib)"; fontname="Helvetica"; style=rounded;
    val [label="Validate\n(fixed scenario table,\nlatency list)", fillcolor="#FCE5CD"];
    run [label="iverilog + vvp\nfixed argument lists,\ntimeouts"];
    dir [label="Run directory\nwave.vcd  sim.log  meta.json"];
    idx [label="VCD index\n(30 signals, window queries)"];
    rec [label="Cache reconstruction\n(refill / reset events)"];
  }
  gtk [label="GTKWave", fillcolor="#F4CCCC"];
  ui -> val [label="POST /api/run"]; val -> run -> dir; dir -> idx; idx -> rec;
  idx -> wv [label="GET wave?t0,t1"]; idx -> fsm [label="GET value?t"]; rec -> cl [label="GET lines?t"];
  dir -> gtk [label="download VCD"];
  wv -> fsm [style=dashed, dir=both, label="cursor"]; wv -> cl [style=dashed, dir=both];
}
