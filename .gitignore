# ==============================================================================
# Direct-Mapped Cache Controller — .gitignore
#
# Generated artifacts are intentionally untracked: they are reproducible with the
# Makefile (make compile / test / regression / wave / synth / perf). A few small
# log/report files are deliberately KEPT as verification evidence (see negations).
# ==============================================================================

# --- Icarus Verilog: compiled simulation binaries ---
*.vvp
*.out
a.out

# --- Waveforms (GTKWave / viewers) ---
*.vcd
*.fst
*.fst.hier
*.ghw
*.lxt
*.lxt2
*.vzt
simulation/waveforms/

# --- Simulation logs (regenerated) — but keep the two evidence logs ---
simulation/logs/*.log
!simulation/logs/tb_cache_lat4.log
!simulation/logs/regression_summary.txt

# --- Yosys / synthesis (the *_stat.txt reports and SUMMARY.md stay tracked) ---
synth/*.json
synth/*.log
*.blif
*.edif
*.asc
*.bit
*.bin

# --- Local simulation run outputs (e.g. the optional portal) ---
results/portal_runs/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.venv/
venv/
env/

# --- LaTeX build files (the report PDF and .tex sources stay tracked) ---
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.lof
report/*.lot
report/*.bbl
report/*.blg
report/*.fls
report/*.fdb_latexmk
report/*.synctex.gz
report/main.pdf

# --- macOS ---
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes
.fseventsd

# --- Editors / IDEs ---
*.swp
*.swo
*~
.vscode/
.idea/
