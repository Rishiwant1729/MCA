# tools / environment
.venv/
__pycache__/
.DS_Store
*.vvp

# generated simulation output (reproduce with: make regression / make wave TEST=...)
simulation/waveforms/*.vcd
simulation/logs/*.log
# tb_cache_lat4.log is kept as verification evidence (expected vs actual per test)
!simulation/logs/tb_cache_lat4.log
!simulation/logs/regression_summary.txt

# generated synthesis output (reproduce with: make synth); the *_stat.txt reports and SUMMARY.md stay tracked
synth/*.json
synth/*.log

# LaTeX build files (the report PDF and sources stay tracked)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.bbl
report/*.blg
report/main.pdf
