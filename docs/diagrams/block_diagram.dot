digraph blocks {
  rankdir=LR; fontname="Helvetica"; compound=true;
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", fillcolor="#EAF2FB"]; edge [fontname="Helvetica", fontsize=9];
  cpu [label="Processor\n(testbench)", fillcolor="#D9EAD3"];
  subgraph cluster_cache { label="cache_controller"; style=rounded; fontname="Helvetica";
    fsm  [label="FSM +\nhit/miss logic\n+ statistics", fillcolor="#FCE5CD"];
    dec  [label="address_decoder\ntag | index | offset"];
    data [label="cache_data_ram\n64 x 16 B\n(16 byte lanes)"];
    tag  [label="cache_tag_ram\n64 x 22 b"];
    val  [label="cache_valid_ram\n64 flip-flops"];
    mif  [label="main_memory_interface\nstart/done + block reg"];
  }
  mem [label="main_memory_model\n(simulation only)\nlatency = LAT", fillcolor="#F4CCCC"];
  cpu -> dec  [label="req_addr"];
  cpu -> fsm  [label="req_valid / req_ready\nresp_valid, rdata, hit, err", dir=both];
  dec -> data [label="index"]; dec -> tag [label="index"]; dec -> val [label="index"];
  tag -> fsm [label="stored tag"]; val -> fsm [label="valid"]; dec -> fsm [label="request tag"];
  data -> fsm [label="line (hit)"];
  fsm -> mif [label="start, block addr"]; mif -> fsm [label="done, block"];
  mif -> data [label="refill block"]; mif -> tag [style=invis];
  fsm -> tag [label="refill: write tag", style=dashed]; fsm -> val [label="refill: set valid", style=dashed];
  mif -> mem [label="mem_req_valid/ready/addr", dir=both]; mem -> mif [label="mem_resp_valid / 128-bit block"];
}
