digraph fsm {
  rankdir=LR; fontname="Helvetica"; node [fontname="Helvetica", fontsize=11, shape=ellipse, style=filled, fillcolor="#EAF2FB"]; edge [fontname="Helvetica", fontsize=9];
  IDLE      [fillcolor="#D9EAD3", label="IDLE\nreq_ready=1"];
  LOOKUP    [label="LOOKUP\ncompare tag + valid"];
  MISS_REQ  [label="MISS_REQ\npulse mem start"];
  WAIT_MEM  [label="WAIT_MEM\nwait for block"];
  REFILL    [label="REFILL\nwrite data/tag/valid"];
  COMPLETE  [fillcolor="#FCE5CD", label="COMPLETE\nresp_valid=1"];
  IDLE -> LOOKUP   [label="accept &&\nrequest OK"];
  IDLE -> COMPLETE [label="accept && bad request\n(resp_err)", style=dashed];
  LOOKUP -> COMPLETE [label="hit"];
  LOOKUP -> MISS_REQ [label="miss"];
  MISS_REQ -> WAIT_MEM [label="always"];
  WAIT_MEM -> WAIT_MEM [label="!mem_done"];
  WAIT_MEM -> REFILL [label="mem_done"];
  REFILL -> COMPLETE [label="always"];
  COMPLETE -> IDLE [label="always"];
  IDLE -> IDLE [label="!accept"];
}
